# ==============================================================================
# OMEGA OS API — PRODUCTION CONFIGURATION (.env)
# ==============================================================================

# Entorno y Servidor
APP_NAME="Omega OS API"
APP_ENV="production"
DEBUG=false
API_V1_PREFIX="/v1"

# Base de Datos PostgreSQL 16 (AsyncPG)
DATABASE_URL="postgresql+asyncpg://omega:omega_super_secret_db_pass@db:5432/omega_os"

# CORS Orígenes Permitidos (separados por coma o JSON list)
CORS_ORIGINS="https://os.omega-studio.tech,https://omega-studio.tech,http://localhost:4200"

# Seguridad JWT (Socios: jackson y yassin)
JWT_SECRET_KEY="change_this_to_a_64_char_random_hex_secret_in_production_omega_os"
JWT_ALGORITHM="HS256"
JWT_EXPIRES_SECONDS=28800
PASSWORD_SALT="omega-os-v1"

# Contraseñas iniciales de los dos únicos socios (usadas en el seed inicial)
PARTNER_JACKSON_PASSWORD="change_me_jackson_prod_password"
PARTNER_YASSIN_PASSWORD="change_me_yassin_prod_password"

# Seguridad Máquina a Máquina para n8n (Cabecera X-Omega-Api-Key)
N8N_SECRET_API_KEY="omega_n8n_secret_api_key_change_in_prod"

# Webhooks Salientes hacia n8n (https://n8n.omega-studio.tech/)
N8N_WEBHOOK_SECRET="omega_n8n_outbound_webhook_signing_secret"
N8N_WEBHOOK_CLIENT_CLOSED="https://n8n.omega-studio.tech/webhook/omega-os/client-closed"
N8N_WEBHOOK_MARGIN_ALERT="https://n8n.omega-studio.tech/webhook/omega-os/margin-alert"
N8N_WEBHOOK_URGENT_TASK="https://n8n.omega-studio.tech/webhook/omega-os/urgent-task"
N8N_WEBHOOK_TIMEOUT_SECONDS=5.0

# Cerebro Omega (RAG SQL en tiempo real + OpenAI opcional)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"
